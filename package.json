{
  "name": "kaogong-potato-new",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4174",
    "server": "node --import tsx server/index.ts",
    "admin": "node --import tsx server/cli.ts",
    "test:unit": "bun test tests/screens_audit.test.ts tests/storage.test.ts tests/storage-regressions.test.ts tests/ui_interaction.test.ts tests/workflow.test.ts tests/workflow-regressions.test.ts tests/m1-regressions.test.ts tests/defects-f01-f12-regression.test.ts tests/sync-core-regressions.test.ts tests/boundaries-regressions.test.ts tests/v10-v11-regressions.test.ts --timeout 60000",
    "test:server": "node --import tsx --test tests/server.test.ts",
    "test:dr": "node --import tsx --test tests/disaster-recovery.test.ts",
    "test": "npm run test:unit && npm run test:server && npm run test:dr",
    "verify:boundaries": "bun scripts/verify-boundaries.ts",
    "verify:isolated": "bun scripts/run-isolated-audit.ts",
    "verify:business": "bun scripts/business-e2e-audit.ts",
    "verify:auth": "bun scripts/auth-epoch-audit.ts",
    "verify:backup": "bun scripts/backup-restore-audit.ts",
    "verify:apk": "./scripts/build-apk.sh --unsigned-verify",
    "verify:apk-old": "./scripts/build-apk.sh --verify-apk release/apk/kaogong-potato-v1.0.2.apk"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "5",
    "lucide-react": "^1.16.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}

# ==============================================================================
# 考公工作台 · 生产部署环境变量模板 (deploy/release.env.example)
# ==============================================================================
# 安全警告：
# 1. 绝对不要将包含真实密钥的 release.env 或 .env 文件提交到 Git 仓库！
# 2. 绝对不要在聊天工具、命令历史或共享日志中明文打印 SESSION_SECRET 或签名口令！
# 3. 生产部署前复制本文件为 release.env：
#    cp deploy/release.env.example deploy/release.env
#    chmod 600 deploy/release.env
# ==============================================================================

# [必须] 生产不可变镜像名称与标签或 digest (禁止使用 latest 避免意外漂移)
# 示例: kaogong-potato:1.0.5 或 kaogong-potato@sha256:abcdef...
APP_IMAGE=kaogong-potato:1.0.5

# [必须] 生产宿主机持久化数据卷的真实绝对物理路径
# 警告：禁止使用相对路径，必须为服务器上已存在的真实绝对路径
# 示例: /data/kaogong/data 或 /var/lib/kaogong/data
PROD_DATA_DIR=/data/kaogong/data

# [必须] 会话签名密钥 (强随机熵，最少 32 字符)
# 生成方式: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# [可选] 宿主机回环监听端口 (默认 3000)
# 仅绑定 127.0.0.1，供 Nginx / Caddy 等反向代理反代使用
PORT=3000

# [可选] 系统邮件提醒；留空时邮件功能停用，其余学习功能照常运行
# QQ SMTP 使用 smtp.qq.com:465；SMTP_FROM 填纯邮箱地址，不带显示名
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 验证码 HMAC 密钥，至少 16 字符，建议单独生成 32 字节随机值
EMAIL_CODE_SECRET=
